{
  "expo": {
    "name": "Gatherup",
    "slug": "gatherup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "backgroundColor": "#e6e6e6",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rnapp.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Gatherup uses your camera for video calls and capturing media.",
        "NSMicrophoneUsageDescription": "Gatherup uses your microphone for voice messages and video calls.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rnapp.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Gatherup to access your microphone for voice messages and calls."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#e6e6e6"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-dontwarn expo.modules.kotlin.**\n-keep class expo.modules.kotlin.** { *; }\n\n-keep class org.webrtc.** { *; }\n-dontwarn org.webrtc.**\n\n-keep class io.socket.** { *; }\n-dontwarn io.socket.**\n-keep class okhttp3.** { *; }\n-dontwarn okhttp3.**\n-keep class okio.** { *; }\n-dontwarn okio.**",
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-asset",
      "./plugins/withAnimatedWebpSupport.js",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "5f47506f-7fe6-4e2a-b1e5-dd1660eb50ac"
      }
    },
    "owner": "vedantvermajsxxs-team"
  }
}
