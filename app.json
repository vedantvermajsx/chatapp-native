{
  "expo": {
    "name": "Gatherup",
    "backgroundColor": "#e6e6e6",
    "slug": "gatherup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rnapp.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Gatherup to access your camera for video calls.",
        "NSMicrophoneUsageDescription": "Allow Gatherup to access your microphone for calls."
      }
    },
    "android": {
      "package": "com.rnapp.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#e6e6e6"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Gatherup to access your microphone for voice messages."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8e0e65f5-acd4-4f4e-ac65-dc150a396146"
      }
    },
    "owner": "vedantvermajss-team"
  }
}
