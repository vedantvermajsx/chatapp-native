{
  "expo": {
    "name": "Gatherup",
    "slug": "gatherup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "backgroundColor": "#e6e6e6",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rnapp.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Gatherup uses your camera for video calls and capturing media.",
        "NSMicrophoneUsageDescription": "Gatherup uses your microphone for voice messages and video calls."
      }
    },
    "android": {
      "package": "com.rnapp.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Gatherup to access your microphone for voice messages and calls."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#e6e6e6"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-dontwarn expo.modules.kotlin.**\n-keep class expo.modules.kotlin.** { *; }",
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "1ef0bd87-e09c-4cf0-8cff-859b8e824513"
      }
    },
    "owner": "vedantvermajsxs-team"
  }
}
