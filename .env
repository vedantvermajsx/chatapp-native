# EXPO_PUBLIC_LOAD_BALENCER_URL=http://10.0.2.2:4000/
# EXPO_PUBLIC_LOAD_BALENCER_URL_=http://10.0.2.2:4000/api

# ==== OPTION 2: Physical device (Expo Go on real phone, SAME WiFi as computer) ====
