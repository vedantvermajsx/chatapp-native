# Android Emulator: use 10.0.2.2 instead of localhost to reach your computer's localhost
#EXPO_PUBLIC_LOAD_BALENCER_URL=http://localhost:4000/
#EXPO_PUBLIC_LOAD_BALENCER_URL_=http://localhost:4000/api
